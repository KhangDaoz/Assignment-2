        "  def __getitem__(self, idx):\n",
        "    img = self.images[idx].transpose(1, 2, 0)  # convert from (C, H, W) to (H, W, C)\n",
        "    if self.transform:\n",
        "      img = self.transform(img)\n",
        "    label = self.labels[idx]\n",
